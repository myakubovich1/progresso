# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public anon key supported as an alternative.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Google and Confirm email in Supabase; configure /auth/callback redirects.
# Google OAuth secrets and SMTP credentials belong in Supabase, not this file.
# See docs/AUTHENTICATION.md for templates and the live verification checklist.
# No service-role key is used by this app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Explicit local demo only; disabled by default, never allowed with VERCEL set.
PROGRESSO_DEMO_MODE=false
# Optional absolute directory for persistent local demo storage.
PROGRESSO_DEMO_DIR=
